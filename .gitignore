# ============================================================
#  Keil 编译产物（约 112MB，绝对不能传）
#  MDK-ARM/2027Diansai/ 里是 .o .axf .hex .map .crf .d .dep .htm .lnp
# ============================================================
MDK-ARM/2027Diansai/
MDK-ARM/*.lst

# ============================================================
#  Keil 每台机器自己的设置（换电脑就该重新生成）
#    *.uvprojx 是工程文件，含依赖列表，必须传  ← 别加进来
#    *.uvoptx  是断点/窗口布局，含个人习惯
#    *.uvguix.* 是界面布局，文件名里带用户名
#    RTE/ DebugConfig/ 是 Keil 自动生成的，已确认源码没引用
# ============================================================
MDK-ARM/*.uvoptx
MDK-ARM/*.uvguix.*
MDK-ARM/RTE/
MDK-ARM/DebugConfig/

# ============================================================
#  CubeMX 自动拷进来、但本工程完全没引用的库（约 47MB）
#  已确认 .uvprojx 的 IncludePath 不含它们，也没有编译进去
#  只忽略这两个，CMSIS 的 Core/Include/Device 是编译必需的，不要动
# ============================================================
Drivers/CMSIS/DSP/
Drivers/CMSIS/NN/

# ============================================================
#  本机工具配置
# ============================================================
.claude/

# ============================================================
#  杂项
# ============================================================
*.bak
*.tmp
*.orig
Thumbs.db
desktop.ini
